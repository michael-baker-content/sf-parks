# Optional: enables the on-demand map embedded on destination pages.
# Restrict this key to the Google Maps Embed API and approved website referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Optional MapLibre style override. The default is OpenFreeMap Positron.
NEXT_PUBLIC_MAP_STYLE_URL=

# Required only when refreshing the 511 SF Bay regional GTFS import.
# Keep this server-side; do not prefix it with NEXT_PUBLIC_.
511_API_KEY=

# Required when importing DataSF datasets so scheduled traffic is identifiable.
SF_PARKS_CONTACT=

# Optional: enables the five-destination, build-time Pixabay image pilot.
# Keep this server-side; do not prefix it with NEXT_PUBLIC_.
PIXABAY_API_KEY=
